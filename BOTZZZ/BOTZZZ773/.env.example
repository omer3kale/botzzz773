# Supabase Configuration
# Get these from your Supabase dashboard: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Secret - Generate with: openssl rand -base64 64
JWT_SECRET=your-jwt-secret-generate-with-openssl-rand-base64-64

# Payeer Payment Gateway
# Get from Payeer merchant dashboard
PAYEER_MERCHANT_ID=your-merchant-id
PAYEER_SECRET_KEY=your-secret-key
PAYEER_ACCOUNT=your-payeer-account

# Application
FRONTEND_URL=https://your-site.netlify.app
SITE_URL=https://your-site.netlify.app
ADMIN_EMAIL=admin@yoursite.com
ADMIN_OTP_EMAIL=admin@yoursite.com

# SMTP Configuration for OTP emails (Gmail)
# Generate App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password

# Pricing Configuration
DEFAULT_TARGET_MARKUP_PERCENT=22.5
DEFAULT_MIN_MARKUP_PERCENT=12
PRICING_RULE_CACHE_MS=60000
APP_NAME=SMM Reseller Panel
